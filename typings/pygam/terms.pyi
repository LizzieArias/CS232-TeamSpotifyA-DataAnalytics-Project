from abc import ABCMeta, abstractmethod, abstractproperty
from typing import Any

import numpy.typing as npt
from pygam.core import Core

"""
Link functions
"""

class Term(Core):
    __metaclass__ = ABCMeta
    def __init__(
        self,
        feature,
        lam=...,
        dtype=...,
        fit_linear=...,
        fit_splines=...,
        penalties=...,
        constraints=...,
        verbose=...,
    ) -> None: ...
    def __len__(self) -> Literal[1]: ...
    def __eq__(self, other) -> bool: ...
    def __radd__(self, other) -> TermList: ...
    def __add__(self, other) -> TermList: ...
    def __mul__(self, other): ...
    def __repr__(self) -> str: ...
    @property
    def istensor(self) -> bool: ...
    @property
    def isintercept(self) -> bool: ...
    @property
    def info(self) -> dict[str, Any]: ...
    @classmethod
    def build_from_info(
        cls, info
    ) -> (
        TensorTerm
        | TermList
        | Self
        | Intercept
        | FactorTerm
        | LinearTerm
        | SplineTerm
        | Term
    ): ...
    @property
    def hasconstraint(self): ...
    @property
    @abstractproperty
    def n_coefs(self) -> None: ...
    @abstractmethod
    def compile(self, X, verbose=...) -> Self: ...
    @abstractmethod
    def build_columns(self, X, verbose=...) -> None: ...
    def build_penalties(self, verbose=...) -> NDArray[Any] | float64: ...
    def build_constraints(
        self, coef, constraint_lam, constraint_l2
    ) -> NDArray[Any] | float64: ...

class Intercept(Term):
    def __init__(self, verbose=...) -> None: ...
    def __repr__(self) -> str: ...
    @property
    def n_coefs(self) -> Literal[1]: ...
    def compile(self, X, verbose=...) -> Self: ...
    def build_columns(self, X, verbose=...) -> csc_matrix: ...

class LinearTerm(Term):
    def __init__(
        self,
        feature,
        lam=...,
        penalties=...,
        verbose=...,
    ) -> None: ...
    @property
    def n_coefs(self) -> Literal[1]: ...
    def compile(self, X, verbose=...) -> Self: ...
    def build_columns(self, X, verbose=...) -> csc_matrix: ...

class SplineTerm(Term):
    _bases = ...
    def __init__(
        self,
        feature,
        n_splines=...,
        spline_order=...,
        lam=...,
        penalties=...,
        constraints=...,
        dtype=...,
        basis=...,
        by=...,
        edge_knots=...,
        verbose=...,
    ) -> None: ...
    @property
    def n_coefs(self) -> int: ...
    def compile(self, X, verbose=...) -> Self: ...
    def build_columns(self, X, verbose=...) -> Any | csc_matrix: ...

class FactorTerm(SplineTerm):
    _encodings = ...
    def __init__(
        self,
        feature,
        lam=...,
        penalties=...,
        coding=...,
        verbose=...,
    ) -> None: ...
    def compile(self, X, verbose=...) -> Self: ...
    def build_columns(self, X, verbose=...) -> Any | csc_matrix: ...
    @property
    def n_coefs(self) -> int: ...

class MetaTermMixin:
    _plural = ...
    _term_location = ...
    def __setattr__(self, name, value) -> None: ...
    def __getattr__(self, name) -> list[Any] | Any: ...

class TensorTerm(SplineTerm, MetaTermMixin):
    _N_SPLINES = ...
    def __init__(self, *args, **kwargs) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i): ...
    @property
    def info(self) -> dict[str, Any]: ...
    @classmethod
    def build_from_info(cls, info) -> Self: ...
    @property
    def hasconstraint(self) -> Literal[False]: ...
    @property
    def n_coefs(self) -> float64: ...
    def compile(self, X, verbose=...) -> Self: ...
    def build_columns(self, X, verbose=...) -> csc_matrix: ...
    def build_penalties(self) -> csc_matrix: ...
    def build_constraints(
        self, coef, constraint_lam, constraint_l2
    ) -> csc_matrix: ...

class TermList(Core, MetaTermMixin):
    _terms = ...
    def __init__(self, *terms, **kwargs) -> None: ...
    def __eq__(self, other) -> bool: ...
    def __repr__(self) -> str: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i): ...
    def __radd__(self, other) -> TermList: ...
    def __add__(self, other) -> TermList: ...
    def __mul__(self, other): ...
    @property
    def info(self) -> dict[str, str | Any | bool]: ...
    @classmethod
    def build_from_info(cls, info) -> Self: ...
    def compile(self, X, verbose=...) -> Self: ...
    def pop(self, i=...): ...
    @property
    def hasconstraint(self) -> Literal[False]: ...
    @property
    def n_coefs(self) -> int: ...
    def get_coef_indices(self, i=...) -> list[int]: ...
    def build_columns(self, X, term=..., verbose=...): ...
    def build_penalties(self) -> _COOArray2D[Any]: ...
    def build_constraints(
        self, coefs, constraint_lam, constraint_l2
    ) -> _COOArray2D[Any]: ...

def l(feature, lam=..., penalties=..., verbose=...) -> LinearTerm: ...
def s(
    feature: int,
    n_splines: int = ...,
    spline_order: int = ...,
    penalties: Any = ...,
    constraints: Any = ...,
    dtype: Any = ...,
    basis: str | None = ...,
    lam: float | npt.ArrayLike | None = ...,
    inverse: bool = ...,
    offset: float | None = ...,
    basis_kwargs: dict[str, Any] | None = ...,
    **kwargs: Any,
) -> Any: ...
def f(
    feature, lam=..., penalties=..., coding=..., verbose=...
) -> FactorTerm: ...
def te(*args, **kwargs) -> TensorTerm: ...

